rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Staff & Administrator verification
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.email == 'joshuaegesienyinnaya@gmail.com' ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email.matches('.*staff.*') ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    // Reservations collection
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Room Inventory collection
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }

    // Guest folio and service requests
    match /service_requests/{requestId} {
      allow read, write: if true;
    }

    // Post-stay guest feedback and reviews
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Hotel audit logs and notes
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Staff accounts directory
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Guest profiles & loyalty membership accounts
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
